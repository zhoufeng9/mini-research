# 复制本文件为 .env，再填写你自己的密钥。
#
# 安全提示：
# - 不要把真实密钥写回 .env.example；这个文件会提交到 Git。
# - .env 已被 .gitignore 忽略，只保存在本机。
# - 如果密钥曾出现在可提交文件中，应在对应服务后台撤销旧密钥并创建新密钥。

# 必填：默认模型和搜索服务
OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_tavily_api_key

# 可选：模型与网页内容长度
MINI_RESEARCH_MODEL=openai:gpt-4.1-mini
MAX_CONTENT_CHARS=12000

# 可选：LangSmith 调试追踪。初学阶段默认关闭，减少额外的数据流向和变量。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=mini-research
